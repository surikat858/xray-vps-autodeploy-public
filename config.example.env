# Copy to config.env, chmod 600, and edit on the NEW VPS. Never commit it.
DOMAIN=vpn-example.duckdns.org
LE_EMAIL=admin@example.com
# Optional: DuckDNS domain already created in your DuckDNS dashboard
DUCKDNS_TOKEN=
SSH_PORT=22
VPN_PORT=443
WS_PATH=/vpn-ws-2026
CLIENT_NAME=phone01
XUI_VERSION=v3.11.0
# 'bundled' keeps tested Xray from 3X-UI; latest/pinned are explicit overrides.
XRAY_VERSION=bundled
# Reserved for future use; strict firewall is a separate manual step
STRICT_FIREWALL=no

# sqlite (default) or postgres (local instance installed by official 3X-UI)
XUI_DB_TYPE=sqlite
# ssh: plain HTTP on 127.0.0.1 through SSH; domain: TLS using the Certbot domain cert
PANEL_TLS_MODE=ssh
